pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    environment {
        SONAR_HOST_URL  = 'http://sonarqube:9000'
        SONAR_TOKEN     = credentials('sonar-token')
        ZAP_HOST        = 'http://owasp-zap:8090'
        ZAP_API_KEY     = 'zap-api-key'
        TARGET_URL      = 'http://sample-app:8080'
        DOCKER_IMAGE    = "myapp:${BUILD_NUMBER}"
        REGISTRY        = 'registry.example.com'
        APP_DIR         = 'app'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Building branch: ${env.GIT_BRANCH}"
            }
        }

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    jacoco execPattern: '**/target/jacoco.exec'
                }
            }
        }

        stage('SAST – SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=my-project \
                              -Dsonar.host.url=${SONAR_HOST_URL} \
                              -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir("${APP_DIR}") {
                    dependencyCheck(
                        additionalArguments: '--scan ./ --format HTML --format JSON --out ./reports',
                        odcInstallation: 'owasp-dc'
                    )
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: '**/reports/dependency-check-report.json'
                    archiveArtifacts artifacts: '**/reports/dependency-check-report.*', allowEmptyArchive: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh "docker build -t ${DOCKER_IMAGE} ."
                }
            }
        }

        stage('Container Security Scan (Trivy)') {
            steps {
                sh """
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      aquasec/trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      ${DOCKER_IMAGE}
                """
            }
        }

        stage('Deploy to Staging') {
            steps {
                sh """
                    docker stop myapp-staging || true
                    docker rm myapp-staging || true
                    docker run -d --name myapp-staging \
                      --network devsecops-net \
                      -p 8888:8080 \
                      ${DOCKER_IMAGE}
                """
                echo "App running at ${TARGET_URL}"
            }
        }

        stage('DAST – OWASP ZAP Scan') {
            steps {
                sh """
                    mkdir -p reports

                    curl -s "${ZAP_HOST}/JSON/spider/action/scan/?apikey=${ZAP_API_KEY}&url=${TARGET_URL}&recurse=true"
                    sleep 30

                    curl -s "${ZAP_HOST}/JSON/ascan/action/scan/?apikey=${ZAP_API_KEY}&url=${TARGET_URL}&recurse=true"
                    sleep 60

                    curl -s "${ZAP_HOST}/OTHER/core/other/htmlreport/?apikey=${ZAP_API_KEY}" \
                      -o reports/zap-report.html

                    HIGH=\$(curl -s "${ZAP_HOST}/JSON/alert/view/alertsSummary/?apikey=${ZAP_API_KEY}" \
                      | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('alertsSummary',{}).get('High',0))")
                    echo "ZAP High-risk alerts: \$HIGH"
                    if [ "\$HIGH" -gt "0" ]; then
                      echo "FAIL: High-risk vulnerabilities found by OWASP ZAP"
                      exit 1
                    fi
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/zap-report.html', allowEmptyArchive: true
                    publishHTML(target: [
                        reportName: 'ZAP Security Report',
                        reportDir: 'reports',
                        reportFiles: 'zap-report.html',
                        keepAll: true
                    ])
                }
            }
        }

        stage('Push to Registry') {
            when {
                expression { env.GIT_BRANCH == 'origin/master' || env.GIT_BRANCH == 'origin/main' }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'registry-creds',
                                                  usernameVariable: 'USER',
                                                  passwordVariable: 'PASS')]) {
                    sh """
                        echo \$PASS | docker login ${REGISTRY} -u \$USER --password-stdin
                        docker tag ${DOCKER_IMAGE} ${REGISTRY}/${DOCKER_IMAGE}
                        docker push ${REGISTRY}/${DOCKER_IMAGE}
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ Pipeline passed all security gates!"
        }
        failure {
            echo "❌ Pipeline failed — review security reports."
        }
    }
}
